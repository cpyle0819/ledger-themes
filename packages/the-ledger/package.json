{
  "name": "@cpyle0819/ledger-theme-the-ledger",
  "version": "1.4.0",
  "description": "The Ledger's original theme: leather, parchment, brass, and a tooled-leather cartouche. The bundled reference theme.",
  "type": "module",
  "files": [
    "theme.css",
    "mark.js",
    "leather.jpg",
    "paper-stain.svg",
    "sounds/"
  ],
  "peerDependencies": {
    "@cpyle0819/ambience": "^2.0.0"
  },
  "ledgerTheme": {
    "id": "the-ledger",
    "name": "The Ledger",
    "tagline": "leather, parchment & brass",
    "subtitle": "an archive of <em>epics</em>, <em>stories</em> &amp; <em>tasks</em>",
    "stylesheet": "./theme.css",
    "fonts": "https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=IM+Fell+English+SC&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Caslon+Display&display=swap",
    "logo": { "tag": "ledger-mark", "src": "./mark.js" },
    "ambient": { "tag": "smoke-drift", "src": "@cpyle0819/ambience/smoke-drift", "attrs": { "color": "rgb(232 222 196)", "opacity": "0.5", "wind": "300", "fire": true } },
    "sounds": {
      "pageTurn": { "src": "./sounds/page-turn.ogg", "volume": 0.5, "startAt": 1.7 },
      "quill": { "src": "./sounds/quill.ogg", "volume": 0.45, "maxMs": 1400 }
    },
    "settings": [
      { "target": "ambient", "attr": "fire", "type": "boolean", "label": "Firelight", "default": true },
      { "target": "ambient", "attr": "wind", "type": "range", "label": "Draught", "min": 0, "max": 600, "step": 50, "default": 300 }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpyle0819/ledger-themes.git",
    "directory": "packages/the-ledger"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
